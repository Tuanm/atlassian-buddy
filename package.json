{
  "name": "atlassian-buddy",
  "version": "0.1.0",
  "description": "MCP server for Atlassian Confluence and Jira",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build --compile --target=bun --minify src/index.ts --outfile=dist/atlassian-buddy",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.0",
    "bun-types": "^1.3.0"
  }
}
